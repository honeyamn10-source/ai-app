# Runtime
NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:8787
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
# Allow Ollama/local providers (always on in development)
ALLOW_LOCAL_PROVIDERS=false
# Generate with: openssl rand -hex 32
BYAK_MASTER_KEY=replace-with-64-hex-characters
BYAK_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Production services (the local reference server uses its encrypted file store)
DATABASE_URL=postgresql://byak:change-me@localhost:5432/byak
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=byak-files
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

# OAuth / billing
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_PLAY_PACKAGE_NAME=ai.byak.app
# Service account JSON (inline or a file path) with Android Publisher access
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PLAY_SUBSCRIPTION_PRODUCT_ID=byak_pro
PLAY_MONTHLY_BASE_PLAN_ID=monthly
PLAY_ANNUAL_BASE_PLAN_ID=yearly
# Shared secret appended to the Pub/Sub push URL: /v1/billing/google/rtdn?token=...
GOOGLE_PLAY_RTDN_TOKEN=

# Optional research services
BRAVE_SEARCH_API_KEY=
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

